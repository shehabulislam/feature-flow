# FeatureFlow — Environment Variables
# Copy this file to .env and fill in the values

# ═══════════════════════════════════════
# DATABASE (Required)
# ═══════════════════════════════════════
# PostgreSQL connection string
# Local:      postgresql://user:password@localhost:5432/featureflow
# Supabase:   postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
# Neon:       postgresql://[user]:[password]@[host]/[dbname]?sslmode=require
# Fly.io:     (set automatically via `fly postgres attach`)
DATABASE_URL="postgresql://featureflow:featureflow@localhost:5432/featureflow?schema=public"

# ═══════════════════════════════════════
# AUTH (Required)
# ═══════════════════════════════════════
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-random-secret"

# Your app's public URL (used by NextAuth for callbacks)
NEXTAUTH_URL="http://localhost:3000"

# ═══════════════════════════════════════
# FREEMIUS (Optional — for billing)
# ═══════════════════════════════════════
# Get these from your Freemius Developer Dashboard
# FREEMIUS_PRODUCT_ID=""
# FREEMIUS_API_KEY=""
# FREEMIUS_SECRET_KEY=""
# FREEMIUS_PUBLIC_KEY=""
# NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ═══════════════════════════════════════
# SUPER ADMIN
# ═══════════════════════════════════════
# The super admin email is configured in:
# src/lib/superadmin.ts
# Default: accounts@bplugins.com
